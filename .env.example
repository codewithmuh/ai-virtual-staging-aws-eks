# Copy to .env for local runs. Never commit .env; in AWS the keys live in Secrets Manager.
LOG_LEVEL=info

# AI providers. "fake" works with no keys and no cost; switch when you have keys.
IMAGE_PROVIDER=fake          # openai | gemini | fake
WRITER_PROVIDER=fake         # claude | fake
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# OPENAI_IMAGE_MODEL=gpt-image-2
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# CLAUDE_MODEL=claude-opus-5-5
# VISITOR_DAILY_LIMIT=5
# IP_DAILY_LIMIT=20
# GLOBAL_DAILY_LIMIT=200
# STRUCTURE_THRESHOLD=0.55
