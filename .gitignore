# Secrets and local config — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.tfvars
!*.example.tfvars

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
dist/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# Editors / OS
.DS_Store
.idea/
*.swp

# Images brought in by `make examples` (large originals; the processed copies are committed)
/examples-src/
